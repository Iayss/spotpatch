# Spotpatch Environment Configuration Template
# Copy this file to .env to override default system behavior (optional).

# Custom path to Spotify's xpui.spa archive (if not in standard %APPDATA%\Spotify\Apps\xpui.spa)
# SPOTIFY_SPA_PATH=C:\Custom\Path\To\Spotify\Apps\xpui.spa

# Custom theme directory (defaults to themes/default)
# SPOTIFY_THEME_DIR=themes/default

# Set to 1 to skip Spotify process detection guard
# SPOTIFY_NO_PROC_CHECK=0
